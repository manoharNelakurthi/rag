{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Legal RAG",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py",
        "--server.port",
        "8502",
        "--server.address",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}/legal_rag_project",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
